apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
{% if k8s_control_plane_endpoint | default('') | length > 0 %}
controlPlaneEndpoint: "{{ k8s_control_plane_endpoint }}"
{% endif %}
networking:
{% if k8s_use_pod_cidr or k8s_install_flannel %}
  podSubnet: "{{ k8s_pod_network_cidr }}"
{% endif %}
controllerManager:
  extraArgs:
    allocate-node-cidrs: "true"
{% if k8s_use_pod_cidr or k8s_install_flannel %}
    cluster-cidr: "{{ k8s_pod_network_cidr }}"
{% endif %}
